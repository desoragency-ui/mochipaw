---
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import { ShopBrowser } from './react/ShopBrowser';
import { categories } from '../data/categories';
import Base from '../layouts/Base.astro';
import { localePath } from '../i18n';
import type { Locale, Product } from '../lib/types';

interface Props {
  locale: Locale;
  path: string;
  title: string;
  intro: string;
  label: string;
  seoTitle: string;
  products: Product[];
  hideCategories?: boolean;
  emptyText?: string;
  tone?: 'purple' | 'orange';
  /** Full-frame photo behind the header. */
  photo?: { name: string; alt: string };
  /** Cut-out standing at the end of the header. */
  cutout?: { name: string; alt: string };
}

const { locale, path, title, intro, label, seoTitle, products, hideCategories, emptyText, tone = 'purple', photo, cutout } = Astro.props;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL(localePath(locale, '/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: label, item: new URL(localePath(locale, path), Astro.site).href },
  ],
};
---

<Base locale={locale} path={path} title={seoTitle} description={intro} jsonLd={[breadcrumb]}>
  <Breadcrumbs locale={locale} items={[{ label }]} />
  <header class={`relative mx-[clamp(0.6rem,1.7vw,1.5rem)] mt-4 flex flex-col overflow-hidden rounded-panel px-6 py-10 sm:px-12 sm:py-14 ${tone === 'purple' ? 'bg-purple text-cream' : 'bg-orange text-brown'}`}>
    {
      photo ? (
        <Photo name={photo.name} alt={photo.alt} sizes="100vw" width={1600} height={900} eager class="relative order-last -mx-6 -mb-10 mt-6 aspect-[16/10] w-[calc(100%+3rem)] max-w-none object-cover object-right sm:-mx-12 sm:-mb-14 sm:w-[calc(100%+6rem)] md:absolute md:inset-0 md:m-0 md:aspect-auto md:h-full md:w-full">
          <span class={`absolute -bottom-24 -end-16 h-72 w-80 rounded-[58%_42%_46%_54%/56%_48%_52%_44%] ${tone === 'purple' ? 'bg-orange' : 'bg-purple'}`} aria-hidden="true" />
        </Photo>
      ) : (
        <span class={`absolute -bottom-24 -end-16 h-72 w-80 rounded-[58%_42%_46%_54%/56%_48%_52%_44%] ${tone === 'purple' ? 'bg-orange' : 'bg-purple'}`} aria-hidden="true" />
      )
    }
    {cutout && <Photo name={cutout.name} alt={cutout.alt} sizes="420px" eager class="absolute -bottom-2 end-3 hidden h-[115%] w-auto max-w-none sm:block lg:end-16" />}
    <div class={`relative max-w-2xl ${photo ? 'md:max-w-[52%] md:py-8 lg:py-16' : ''}`}>
      <h1 class="display text-5xl sm:text-7xl">{title}</h1>
      <p class="mt-3 text-lg font-bold">{intro}</p>
    </div>
  </header>
  <div class="shell mt-8">
    <ShopBrowser client:load products={products} categories={categories.map(({ slug, name }) => ({ slug, name }))} locale={locale} hideCategories={hideCategories} emptyText={emptyText} />
  </div>
</Base>
