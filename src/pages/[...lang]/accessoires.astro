---
import Listing from '../../components/Listing.astro';
import { langPaths, t } from '../../i18n';
import { productsInCategory } from '../../lib/catalog';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const d = t(locale);
---

<Listing
  locale={locale}
  path="/accessoires"
  title={d.accessories.title}
  intro={d.accessories.intro}
  label={d.nav.accessories}
  seoTitle={d.seo.accessories}
  products={productsInCategory('accessoires')}
  hideCategories
/>
