---
import Listing from '../../components/Listing.astro';
import { langPaths, t } from '../../i18n';
import { onOffer } from '../../lib/catalog';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const d = t(locale);
---

<Listing
  locale={locale}
  path="/offres"
  title={d.offers.title}
  intro={d.offers.intro}
  label={d.nav.offers}
  seoTitle={d.seo.offers}
  products={onOffer()}
  cutout={{ name: 'offers-duo', alt: d.alts.offers }}
  emptyText={d.offers.empty}
  tone="orange"
/>
