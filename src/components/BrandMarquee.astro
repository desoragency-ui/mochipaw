---
import { PawPrint } from 'lucide-react';
import { brands } from '../data/brands';
import { localePath, t } from '../i18n';
import type { Locale } from '../lib/types';

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const shop = localePath(locale, '/boutique');
const href = (name: string) => `${shop}?marque=${encodeURIComponent(name)}`;
---

<section
  class="relative mx-[clamp(0.6rem,1.7vw,1.5rem)] mt-20 overflow-hidden rounded-panel bg-orange text-brown"
  aria-labelledby="brands-title"
  data-reveal
>
  <div class="pattern absolute inset-0 opacity-[0.12]" aria-hidden="true"></div>
  <span data-drift class="absolute -end-24 -top-28 h-72 w-72 rounded-[58%_42%_46%_54%/56%_48%_52%_44%] bg-blush/60" aria-hidden="true"></span>

  <div class="relative px-6 pb-8 pt-12 sm:px-12">
    <h2 id="brands-title" class="display flex max-w-3xl flex-wrap items-center gap-x-4 gap-y-1 text-4xl sm:text-6xl">
      {d.brands.title}
      <span class="brand-paw grid h-11 w-11 shrink-0 place-items-center rounded-full bg-cream text-purple sm:h-14 sm:w-14" aria-hidden="true">
        <PawPrint size={26} strokeWidth={2.2} />
      </span>
    </h2>
    <p class="mt-3 max-w-xl text-lg font-bold">{d.brands.text}</p>
  </div>

  <!--
    dir="ltr" on purpose: the band moves from left to right in every language, and a drag to the right moves it right.
    Five identical copies make an endless loop; only the middle one (index 2) is read by screen readers and reachable by Tab.
  -->
  <div class="brand-marquee relative mb-12" dir="ltr" data-brand-marquee>
    <ul class="brand-track" aria-label={d.brands.list}>
      {
        [0, 1, 2, 3, 4].map((copy) =>
          brands.map((brand) => (
            <li class="brand-item" aria-hidden={copy === 2 ? undefined : 'true'}>
              <a
                href={href(brand.name)}
                class:list={['brand-card', { 'is-dark': brand.dark }]}
                aria-label={d.brands.open(brand.name)}
                tabindex={copy === 2 ? undefined : -1}
              >
                <img src={brand.logo} alt={copy === 2 ? brand.name : ''} loading="lazy" decoding="async" draggable="false" />
              </a>
            </li>
          )),
        )
      }
    </ul>
  </div>
</section>

<script>
  // Auto-moves the brand band from left to right. The visitor can also drag it (mouse) or swipe it (touch) in
  // either direction; the automatic motion waits while they hold it and picks up again 2.5 s after they let go.
  const COPIES = 5;
  const SECONDS_PER_LOOP = 36;
  const WAIT_AFTER_TOUCH = 2500;

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-brand-marquee]').forEach((band) => {
      const track = band.querySelector<HTMLElement>('.brand-track');
      if (!track) return;

      let loop = 0; // width of one copy
      let pos = 0; // exact scroll position, with decimals
      let hover = false;
      let focused = false;
      let touching = false;
      let dragging = false;
      let moved = false;
      let onScreen = false;
      let holdUntil = 0;
      let startX = 0;
      let startScroll = 0;
      let last = performance.now();

      const measure = () => {
        const next = track.scrollWidth / COPIES;
        if (!next) return;
        // Keep the same place inside the loop when the screen size changes.
        const fraction = loop ? (((pos - loop * 2) % loop) + loop) % loop / loop : 0;
        loop = next;
        pos = loop * 2 + fraction * loop;
        track.style.transform = '';
        band.scrollLeft = pos;
      };

      // One copy further or back looks exactly the same, so jumping by one copy is invisible.
      const normalize = () => {
        if (pos < loop) pos += loop * Math.ceil((loop - pos) / loop);
        else if (pos > loop * 3) pos -= loop * Math.ceil((pos - loop * 3) / loop);
        else return false;
        return true;
      };

      const apply = () => {
        const whole = Math.floor(pos);
        band.scrollLeft = whole;
        track.style.transform = `translate3d(${whole - pos}px, 0, 0)`;
      };

      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        if (loop) {
          // Someone moved the band (swipe, drag, wheel, keyboard focus): follow it and wait.
          if (Math.abs(band.scrollLeft - Math.floor(pos)) > 1.5) {
            pos = band.scrollLeft;
            track.style.transform = '';
            holdUntil = now + WAIT_AFTER_TOUCH;
          }
          const busy = touching || dragging || now < holdUntil;
          const paused = busy || hover || focused || !onScreen || document.hidden;
          if (!paused) {
            pos -= (loop / SECONDS_PER_LOOP) * dt; // scrolling backwards = the content moves to the right
            normalize();
            apply();
          } else if (!busy && normalize()) {
            apply(); // the visitor stopped far from the middle: jump back by whole copies
          }
        }
        requestAnimationFrame(tick);
      };

      new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting), { threshold: 0.05 }).observe(band);
      band.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') hover = true;
      });
      band.addEventListener('pointerleave', () => (hover = false));
      band.addEventListener('focusin', () => (focused = true));
      band.addEventListener('focusout', () => (focused = false));
      band.addEventListener('touchstart', () => (touching = true), { passive: true });
      const release = () => {
        touching = false;
        holdUntil = performance.now() + WAIT_AFTER_TOUCH;
      };
      band.addEventListener('touchend', release, { passive: true });
      band.addEventListener('touchcancel', release, { passive: true });

      // Mouse drag. Touch screens already scroll the band natively.
      band.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        dragging = true;
        moved = false;
        startX = event.clientX;
        startScroll = band.scrollLeft;
        band.classList.add('is-dragging');
      });
      window.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const delta = event.clientX - startX;
        if (Math.abs(delta) > 6) moved = true;
        band.scrollLeft = startScroll - delta;
      });
      const drop = () => {
        if (!dragging) return;
        dragging = false;
        band.classList.remove('is-dragging');
        holdUntil = performance.now() + WAIT_AFTER_TOUCH;
      };
      window.addEventListener('pointerup', drop);
      window.addEventListener('pointercancel', drop);
      band.addEventListener('dragstart', (event) => event.preventDefault());
      // A drag that ends on a logo must not open the shop.
      band.addEventListener(
        'click',
        (event) => {
          if (moved) {
            event.preventDefault();
            event.stopPropagation();
            moved = false;
          }
        },
        true,
      );

      window.addEventListener('resize', measure);
      measure();
      requestAnimationFrame(tick);
    });
  }
</script>

<style>
  /* A scroll box with no visible bar: the script moves it, and a finger or a mouse drag can move it too. */
  .brand-marquee {
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .brand-marquee::-webkit-scrollbar {
    display: none;
  }

  .brand-marquee.is-dragging {
    cursor: grabbing;
  }

  .brand-track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0.5rem 0 1rem;
    list-style: none;
    will-change: transform;
  }

  .brand-item {
    flex: none;
    margin-inline-end: 1rem;
  }

  .brand-card {
    display: grid;
    place-items: center;
    width: 9.5rem;
    height: 5.75rem;
    padding: 0.9rem 1.1rem;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 6px 0 rgb(34 15 6 / 0.16);
    transition:
      transform 0.35s var(--ease-out-soft),
      box-shadow 0.35s ease;
  }

  .brand-card.is-dark {
    background: var(--color-brown);
  }

  .brand-card img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 3.1rem;
    object-fit: contain;
    transition: transform 0.35s var(--ease-out-soft);
  }

  .brand-card:hover,
  .brand-card:focus-visible {
    transform: translateY(-7px) rotate(-2.5deg);
    box-shadow: 0 14px 0 rgb(34 15 6 / 0.2);
  }

  .brand-card:hover img,
  .brand-card:focus-visible img {
    transform: scale(1.1);
  }

  .brand-paw {
    animation: paw-wiggle 3.2s ease-in-out infinite;
  }

  @media (min-width: 640px) {
    .brand-item {
      margin-inline-end: 1.25rem;
    }

    .brand-card {
      width: 11.75rem;
      height: 6.9rem;
    }

    .brand-card img {
      max-height: 3.7rem;
    }
  }

  @keyframes paw-wiggle {
    0%,
    70%,
    100% {
      transform: rotate(0);
    }
    78% {
      transform: rotate(-14deg) scale(1.08);
    }
    86% {
      transform: rotate(10deg) scale(1.08);
    }
  }

  /* People who ask for less motion get a still, wrapped grid instead of a moving band. */
  @media (prefers-reduced-motion: reduce) {
    .brand-track {
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      padding-inline: 1rem;
    }

    .brand-item {
      margin: 0;
    }

    .brand-item[aria-hidden='true'] {
      display: none;
    }

    .brand-marquee {
      overflow: visible;
      cursor: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .brand-paw {
      animation: none;
    }
  }
</style>
