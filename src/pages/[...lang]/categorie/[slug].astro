---
import Listing from '../../../components/Listing.astro';
import { categories } from '../../../data/categories';
import { categoryText, langPaths, t } from '../../../i18n';
import { productsInCategory } from '../../../lib/catalog';

export function getStaticPaths() {
  return langPaths().flatMap((entry) =>
    categories.map((category) => ({
      params: { ...entry.params, slug: category.slug },
      props: { ...entry.props, category },
    })),
  );
}

const { locale, category } = Astro.props;
const text = categoryText(locale, category.slug);
const d = t(locale);
---

<Listing
  locale={locale}
  path={`/categorie/${category.slug}`}
  title={text.name.toLocaleUpperCase(locale)}
  intro={text.description}
  label={text.name}
  seoTitle={d.seo.category(text.name)}
  products={productsInCategory(category.slug)}
  hideCategories
  tone={category.pet === 'chien' ? 'orange' : 'purple'}
/>
