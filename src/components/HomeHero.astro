---
import { localePath, t } from '../i18n';
import type { Locale } from '../lib/types';

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <span class="hero-blob" aria-hidden="true"></span>
  <h1 id="hero-title" class="hero-title display">
    <span class="hero-line">{d.hero.line1}</span>
    <span class="hero-line two">{d.hero.line2}</span>
  </h1>
  <picture>
    <source media="(max-width: 767px)" srcset="/images/hero/home-hero-duo-720.webp" />
    <img
      class="hero-pets"
      src="/images/hero/home-hero-duo.webp"
      alt={d.alts.hero}
      width="1086"
      height="1448"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-copy">
    <p>{d.hero.support}</p>
    <div class="flex flex-wrap gap-2.5">
      <a href={localePath(locale, '/boutique')} class="btn btn-orange">{d.hero.primary}</a>
      <a href={localePath(locale, '/offres')} class="btn btn-cream hidden sm:inline-flex">{d.hero.secondary}</a>
    </div>
  </div>
  <svg class="hero-star" viewBox="0 0 40 40" aria-hidden="true"><path fill="currentColor" d="M20 0c2 12 8 18 20 20-12 2-18 8-20 20-2-12-8-18-20-20C12 18 18 12 20 0Z"></path></svg>
</section>

<style>
  .hero {
    position: relative;
    margin: 0.25rem clamp(0.6rem, 1.7vw, 1.5rem) 0;
    height: clamp(620px, calc(100dvh - 170px), 800px);
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: var(--color-purple);
    color: var(--color-cream);
  }

  .hero-blob {
    position: absolute;
    inset-inline-end: -5%;
    bottom: -18%;
    width: min(54vw, 760px);
    aspect-ratio: 1.08;
    border-radius: 58% 42% 46% 54% / 56% 48% 52% 44%;
    background: var(--color-orange);
    animation: blob-in 1s var(--ease-out-soft) 0.35s both;
  }

  .hero-title {
    position: absolute;
    inset-inline-start: clamp(1.4rem, 3.4vw, 3rem);
    top: clamp(1.4rem, 7vh, 3.6rem);
    font-size: clamp(2.6rem, 8.7vw, 8.25rem);
  }

  .hero-line {
    display: block;
    animation: rise 0.8s var(--ease-out-soft) both;
  }

  .hero-line.two {
    color: var(--color-blush);
    animation-delay: 0.12s;
  }

  .hero-pets {
    position: absolute;
    inset-inline-end: clamp(0.5rem, 2.2vw, 2rem);
    bottom: 0;
    height: 96%;
    width: auto;
    max-width: none;
    animation: settle 0.9s var(--ease-out-soft) 0.2s both;
  }

  .hero-copy {
    position: absolute;
    inset-inline-start: clamp(1.4rem, 3.4vw, 3rem);
    bottom: clamp(1.6rem, 5vh, 2.8rem);
    max-width: 27rem;
    animation: rise 0.8s var(--ease-out-soft) 0.3s both;
  }

  .hero-copy p {
    margin-bottom: 1.3rem;
    font-size: clamp(1.05rem, 1.5vw, 1.32rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .hero-star {
    position: absolute;
    inset-inline-start: 46%;
    top: 56%;
    width: 2.4rem;
    color: var(--color-cream);
    animation: blob-in 0.8s var(--ease-out-soft) 0.6s both;
  }

  [dir='rtl'] .hero-pets {
    transform: scaleX(-1);
  }

  @media (max-width: 767px) {
    .hero {
      display: flex;
      flex-direction: column;
      height: auto;
      padding: 1.6rem 1.4rem 0;
      border-radius: 30px;
    }

    .hero-title {
      position: static;
      order: 1;
      font-size: 11.4vw;
    }

    .hero-copy {
      position: static;
      order: 2;
      max-width: none;
      margin-top: 0.9rem;
      z-index: 2;
    }

    .hero-copy p {
      margin-bottom: 0.9rem;
    }

    .hero > picture {
      position: relative;
      z-index: 1;
      order: 3;
      display: block;
      width: 92%;
      max-width: 380px;
      margin-top: 0.5rem;
      margin-inline-start: auto;
      margin-inline-end: -1rem;
    }

    .hero-pets {
      position: relative;
      inset: auto;
      display: block;
      width: 100%;
      height: auto;
    }

    .hero-blob {
      width: 110vw;
      inset-inline-end: -32%;
      bottom: -12%;
    }

    .hero-star {
      display: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      translate: 0 34px;
      scale: 0.97;
    }
  }

  @keyframes blob-in {
    from {
      opacity: 0;
      scale: 0.7;
    }
  }
</style>
