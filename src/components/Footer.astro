---
import { categories } from '../data/categories';
import { site } from '../data/site';
import { activeLocales, categoryText, localeNames, localePath, t } from '../i18n';
import type { Locale } from '../lib/types';

const { locale, path = '/' } = Astro.props as { locale: Locale; path?: string };
const d = t(locale);
const link = (path: string) => localePath(locale, path);
const socials = Object.entries(site.social).filter(([, url]) => url);
const { phone, email, address, city } = site.contact;
const hasContact = Boolean(phone || email || address);
---

<footer class="relative mt-20 overflow-hidden rounded-t-panel bg-purple text-cream">
  <div class="pattern absolute inset-0 opacity-[0.06]" aria-hidden="true"></div>
  <div class="shell relative grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div>
      <img src="/images/brand/logo-cream.svg" alt="MochiPaw" width="150" height="50" loading="lazy" class="h-14 w-auto" />
      <p class="mt-4 max-w-xs font-semibold">{d.footer.about}</p>
      <p class="mt-3 font-display text-xl font-semibold" lang="en">{site.tagline}</p>
    </div>

    <nav aria-label={d.footer.shop}>
      <h2 class="mb-3 text-xl">{d.footer.shop}</h2>
      <ul class="flex flex-col font-semibold">
        {categories.map((item) => <li><a class="inline-flex min-h-10 items-center hover:underline" href={link(`/categorie/${item.slug}`)}>{categoryText(locale, item.slug).name}</a></li>)}
        <li><a class="inline-flex min-h-10 items-center hover:underline" href={link('/offres')}>{d.nav.offers}</a></li>
      </ul>
    </nav>

    <nav aria-label={d.footer.help}>
      <h2 class="mb-3 text-xl">{d.footer.help}</h2>
      <ul class="flex flex-col font-semibold">
        <li><a class="inline-flex min-h-10 items-center hover:underline" href={link('/contact')}>{d.pages.contact}</a></li>
        <li><a class="inline-flex min-h-10 items-center hover:underline" href={link('/faq')}>{d.pages.faq}</a></li>
        <li><a class="inline-flex min-h-10 items-center hover:underline" href={link('/livraison')}>{d.pages.shipping}</a></li>
        <li><a class="inline-flex min-h-10 items-center hover:underline" href={link('/retours')}>{d.pages.returns}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="mb-3 text-xl">{d.footer.legal}</h2>
      <ul class="flex flex-col font-semibold">
        <li><a class="inline-flex min-h-10 items-center hover:underline" href={link('/a-propos')}>{d.pages.about}</a></li>
        <li><a class="inline-flex min-h-10 items-center hover:underline" href={link('/confidentialite')}>{d.pages.privacy}</a></li>
        <li><a class="inline-flex min-h-10 items-center hover:underline" href={link('/conditions')}>{d.pages.terms}</a></li>
      </ul>
      <div class="mt-5 font-semibold">
        {
          hasContact ? (
            <address class="not-italic">
              {phone && <p>{phone}</p>}
              {email && <p><a class="inline-flex min-h-10 items-center underline hover:no-underline" href={`mailto:${email}`}>{email}</a></p>}
              {address && <p>{address}, {city}</p>}
            </address>
          ) : (
            <p class="opacity-85">{d.footer.contactSoon}</p>
          )
        }
      </div>
      {
        socials.length > 0 && (
          <ul class="mt-3 flex gap-3 font-extrabold capitalize">
            {socials.map(([name, url]) => <li><a class="underline" href={url}>{name}</a></li>)}
          </ul>
        )
      }
    </div>
  </div>
  <div class="shell relative flex flex-wrap items-center justify-between gap-3 border-t border-cream/25 py-5 text-sm font-semibold">
    <p>© {new Date().getFullYear()} MochiPaw. {d.footer.rights}</p>
    {
      activeLocales.length > 1 && (
        <nav aria-label={d.nav.language} class="flex items-center gap-1 font-extrabold">
          {activeLocales.map((item) => (
            <a href={localePath(item, path)} lang={item} hreflang={item} aria-current={item === locale ? 'true' : undefined} class="inline-flex min-h-10 items-center rounded-full px-3 hover:bg-cream/15 aria-[current=true]:bg-cream aria-[current=true]:text-purple">
              {localeNames[item]}
            </a>
          ))}
        </nav>
      )
    }
    <p lang="en">by <a class="inline-flex min-h-10 items-center font-extrabold underline hover:no-underline" href="https://www.desora.net" target="_blank" rel="noopener">Desora Agency</a></p>
    {site.payment.cashOnDelivery && <p class="rounded-full bg-cream/15 px-4 py-1.5">{d.footer.payment}</p>}
  </div>
</footer>
