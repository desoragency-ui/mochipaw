---
import Article from '../../components/Article.astro';
import { langPaths, localePath, t } from '../../i18n';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const d = t(locale);
const a = d.article.about;
---

<Article
  locale={locale}
  path="/a-propos"
  title={a.title}
  photo={{ name: 'about-walk', alt: d.alts.about, width: 960, height: 640 }}
  heading={a.heading}
  description={a.description}
>
  <h2>{a.whoTitle}</h2>
  <p>{a.who1}</p>
  <p>{a.who2}</p>
  <h2>{a.findTitle}</h2>
  <ul>
    {a.items.map((item) => <li>{item}</li>)}
  </ul>
  <p style="margin-top:1.2rem"><a class="btn btn-purple" href={localePath(locale, '/boutique')}>{a.cta}</a></p>
</Article>
