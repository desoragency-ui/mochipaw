---
import Listing from '../../components/Listing.astro';
import { langPaths, t } from '../../i18n';
import { productsForPet } from '../../lib/catalog';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const d = t(locale);
---

<Listing
  locale={locale}
  path="/chats"
  title={d.cats.title}
  intro={d.cats.intro}
  label={d.nav.cats}
  seoTitle={d.seo.cats}
  products={productsForPet('chat')}
  photo={{ name: 'cats-hero', alt: d.alts.cats }}
/>
