---
import Article from '../../components/Article.astro';
import { langPaths, t } from '../../i18n';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const a = t(locale).article.faq;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: a.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Article locale={locale} path="/faq" title={a.title} heading={a.heading} description={a.description} jsonLd={[faqSchema]}>
  {a.items.map((item) => (<><h2>{item.q}</h2><p>{item.a}</p></>))}
</Article>
