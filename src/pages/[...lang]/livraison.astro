---
import Article from '../../components/Article.astro';
import { site } from '../../data/site';
import { langPaths, t } from '../../i18n';
import { formatPrice } from '../../lib/format';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const a = t(locale).article.shipping;
---

<Article locale={locale} path="/livraison" title={a.title} heading={a.heading} description={a.description}>
  {
    site.shippingZones.length > 0 ? (
      <ul>
        {site.shippingZones.map((zone) => (
          <li>{zone.name} : {formatPrice(zone.price, locale)}{zone.delay ? `, ${zone.delay}` : ''}</li>
        ))}
      </ul>
    ) : (
      <>
        <p class="todo">{a.todo}</p>
        <p>{a.text}</p>
      </>
    )
  }
  {site.payment.cashOnDelivery && <p>{a.cod}</p>}
</Article>
