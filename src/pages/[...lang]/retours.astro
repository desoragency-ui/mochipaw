---
import Article from '../../components/Article.astro';
import { langPaths, t } from '../../i18n';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const a = t(locale).article.returns;
---

<Article locale={locale} path="/retours" title={a.title} heading={a.heading} description={a.description}>
  <p class="todo">{a.todo}</p>
  <p>{a.text}</p>
</Article>
