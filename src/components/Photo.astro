---
import { existsSync } from 'node:fs';

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  class?: string;
  width?: number;
  height?: number;
  eager?: boolean;
}

const { name, alt, sizes = '100vw', class: className, width = 960, height = 960, eager } = Astro.props;
const base = `/images/photos/${name}`;
const found = existsSync(`public${base}-480.webp`);
const large = existsSync(`public${base}-1600.webp`);
const srcset = [`${base}-480.webp 480w`, `${base}-960.webp 960w`, ...(large ? [`${base}-1600.webp 1600w`] : [])].join(', ');
---

{
  found ? (
    <img
      src={`${base}-960.webp`}
      srcset={srcset}
      sizes={sizes}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class={className}
    />
  ) : (
    <slot />
  )
}
