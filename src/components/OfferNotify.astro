---
import { BellRing, MessageCircle } from 'lucide-react';
import { Newsletter } from './react/Newsletter';
import { hasWhatsApp, site } from '../data/site';
import { t } from '../i18n';
import type { Locale } from '../lib/types';

/** Shown on the Offres page while no product is on offer: sign up by email or WhatsApp to be told of the next one. */
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const href = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(d.offers.whatsappMessage)}`;
---

<section class="relative overflow-hidden rounded-panel bg-cream-deep px-6 py-12 text-center sm:px-12 sm:py-16" aria-labelledby="offers-notify-title">
  <span class="absolute -start-16 -top-20 h-60 w-60 rounded-[58%_42%_46%_54%/56%_48%_52%_44%] bg-blush/70" aria-hidden="true"></span>
  <div class="relative mx-auto max-w-xl">
    <span class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-full bg-purple text-cream">
      <BellRing size={30} aria-hidden="true" />
    </span>
    <h2 id="offers-notify-title" class="display text-4xl text-purple sm:text-6xl">{d.offers.emptyTitle}</h2>
    <p class="mt-3 text-lg font-bold">{d.offers.emptyText}</p>
    <div class="mt-7 text-start">
      <Newsletter client:visible locale={locale} />
    </div>
    <p class="my-5 font-extrabold text-brown/70" aria-hidden="true">— {d.offers.or} —</p>
    {
      hasWhatsApp() ? (
        <a class="btn btn-orange" href={href} target="_blank" rel="noopener">
          <MessageCircle size={20} aria-hidden="true" /> {d.offers.whatsappCta}
        </a>
      ) : (
        <>
          <span class="btn btn-orange pointer-events-none opacity-60" aria-disabled="true">
            <MessageCircle size={20} aria-hidden="true" /> {d.offers.whatsappCta}
          </span>
          <p class="mt-2 text-sm font-bold text-brown/70">{d.offers.whatsappDemo}</p>
        </>
      )
    }
  </div>
</section>
