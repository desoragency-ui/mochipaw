---
import Article from '../../components/Article.astro';
import { langPaths, t } from '../../i18n';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const a = t(locale).article.privacy;
---

<Article locale={locale} path="/confidentialite" title={a.title} heading={a.heading} description={a.description}>
  <p class="todo">{a.todo}</p>
  <h2>{a.deviceTitle}</h2>
  <p>{a.device}</p>
  <h2>{a.orderTitle}</h2>
  <p>{a.order}</p>
</Article>
