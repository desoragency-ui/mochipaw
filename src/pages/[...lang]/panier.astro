---
import { CartPage } from '../../components/react/CartPage';
import { langPaths, t } from '../../i18n';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const d = t(locale);
---

<Base locale={locale} path="/panier" title={d.nav.cart}>
  <div class="shell mt-8">
    <h1 class="display mb-6 text-5xl text-purple sm:text-7xl">{d.cart.title}</h1>
    <CartPage client:load locale={locale} />
  </div>
</Base>
