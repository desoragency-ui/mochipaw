---
import Article from '../../components/Article.astro';
import { hasWhatsApp, site } from '../../data/site';
import { langPaths, t } from '../../i18n';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const d = t(locale);
const a = d.article.contact;
const { phone, email, address, city, hours } = site.contact;
const hasDetails = Boolean(phone || email || address || hasWhatsApp());
---

<Article
  locale={locale}
  path="/contact"
  title={a.title}
  photo={{ name: 'contact-puppy', alt: d.alts.contact, cutout: true }}
  heading={a.heading}
  description={a.description}
>
  {
    hasDetails ? (
      <>
        {hasWhatsApp() && <p><a class="btn btn-purple" href={`https://wa.me/${site.contact.whatsapp}`}>{d.whatsapp}</a></p>}
        {phone && <p>{a.phone} : {phone}</p>}
        {email && <p>{a.email} : {email}</p>}
        {address && <p>{a.address} : {address}, {city}</p>}
        {hours && <p>{a.hours} : {hours}</p>}
      </>
    ) : (
      <p class="todo">{d.footer.contactSoon}</p>
    )
  }
</Article>
