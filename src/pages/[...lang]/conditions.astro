---
import Article from '../../components/Article.astro';
import { langPaths, t } from '../../i18n';

export const getStaticPaths = langPaths;
const { locale } = Astro.props;
const a = t(locale).article.terms;
---

<Article locale={locale} path="/conditions" title={a.title} heading={a.heading} description={a.description}>
  <p class="todo">{a.todo}</p>
  <h2>{a.priceTitle}</h2>
  <p>{a.price}</p>
  <h2>{a.orderTitle}</h2>
  <p>{a.order}</p>
  <h2>{a.payTitle}</h2>
  <p>{a.pay}</p>
</Article>
